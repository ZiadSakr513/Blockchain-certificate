{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "hardhat"]
  },
  "include": ["./scripts", "./test", "./typechain-types"],
  "exclude": ["node_modules", "frontend"]
}
